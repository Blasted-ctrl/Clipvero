APP_NAME=Clipvero
CLIPVERO_BACKEND=legacy
API_BACKEND_URL=http://127.0.0.1:8000
ENVIRONMENT=development
# FastAPI uses PostgreSQL and Redis. Compose sets the internal service URLs.
DATABASE_URL=postgresql+psycopg://clipvero:replace-me@127.0.0.1:55432/clipvero
REDIS_URL=redis://127.0.0.1:56379/0
# Generate a URL-safe password and session secret; never use example values in production.
POSTGRES_PASSWORD=
# Private R2/S3 integration. Keep the bucket private; no public bucket URL is used.
# Upload/finalization and media validation are not enabled in the FastAPI workspace yet.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
APP_URL=http://localhost:3000
DATA_DIR=./data
# Use a long random value before exposing the server to the internet.
SESSION_SECRET=
# Optional. Local script editing and MP4 rendering work without an AI key.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_IMAGE_MODEL=gpt-image-1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
# Optional: installed system binaries instead of the bundled binaries.
FFMPEG_PATH=
FFPROBE_PATH=
