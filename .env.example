# Local app. Run pnpm setup:env to generate missing secrets safely.
APP_NAME=Clipvero
APP_URL=http://localhost:3000
ENVIRONMENT=development
# legacy runs the working video studio; fastapi currently supports script editing only.
CLIPVERO_BACKEND=legacy
# Generated by pnpm setup:env. Keep existing production values when redeploying.
SESSION_SECRET=

# Private run on your computer. Create this owner account at localhost before pilot:setup.
# NGROK_DOMAIN is the assigned hostname only, without https:// or a path.
PILOT_OWNER_EMAIL=
NGROK_DOMAIN=
NGROK_AUTHTOKEN=

# OpenAI: used by the Node video worker, not by the current FastAPI worker.
# Create a project API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_IMAGE_MODEL=gpt-image-2

# Personal publishing: public HTTPS APP_URL and registered OAuth redirect URLs required.
# Redirects: /api/social/callback/instagram and /api/social/callback/tiktok
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Tokens are encrypted with SESSION_SECRET. Keep it stable and backed up privately.

# Stripe: used by the Node studio. Price IDs must match the secret key's mode.
# Webhook path: /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=

# FastAPI infrastructure. Compose supplies internal database, Redis and API URLs.
# These localhost URLs are for running Python/Next.js outside their containers.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://clipvero:replace-me@127.0.0.1:55432/clipvero
REDIS_URL=redis://127.0.0.1:56379/0
API_BACKEND_URL=http://127.0.0.1:8000

# Private R2/S3. Currently used only by the FastAPI connection/signing boundary.
# Media allocation, validation, uploads and downloads still require implementation.
# Use the exact S3 endpoint shown by R2, including any jurisdiction prefix.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Node studio: persist this directory for the database, uploads and rendered videos.
DATA_DIR=./data
# Optional: leave blank to use bundled media binaries/browser.
FFMPEG_PATH=
FFPROBE_PATH=
REMOTION_BROWSER_EXECUTABLE=

# Content engine providers. Any subset works; empty keys are skipped.
# Script writers are tried in this order; claude-code and codex are local fallbacks.
CLIPVERO_TEXT_PROVIDERS=groq,openrouter,nvidia,anthropic,openai,gemini,deepseek,kimi,qwen,claude-code,codex
# Groq (console.groq.com): very fast hosted models, plus Whisper for word timing.
GROQ_API_KEYS=
GROQ_MODEL=
# OpenRouter (openrouter.ai): only models ending in ":free" are used unless OPEN_ROUTER_ALLOW_PAID=true.
OPEN_ROUTER_KEYS=
OPEN_ROUTER_MODEL=
# NVIDIA NIM (build.nvidia.com): free hosted DeepSeek and others. Several keys may be comma-separated.
NVIDIA_API_KEYS=
NVIDIA_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
MOONSHOT_API_KEY=
KIMI_MODEL=
DASHSCOPE_API_KEY=
QWEN_MODEL=
CLAUDE_BIN=
CODEX_BIN=
# Narration: expressive providers first, local Kokoro as the free fallback.
CLIPVERO_VOICE_PROVIDERS=elevenlabs,gemini,groq,openai,local
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_CUTE=
ELEVENLABS_VOICE_WARM=
ELEVENLABS_VOICE_DEEP=
ELEVENLABS_VOICE_BOLD=
# Watermark account name shown on explainer videos.
CLIPVERO_BRAND_NAME=
