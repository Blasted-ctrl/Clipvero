{
  "name": "clipvero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup:env": "tsx scripts/setup-env.ts",
    "pilot:setup": "tsx scripts/setup-pilot.ts",
    "pilot": "tsx --env-file-if-exists=.env scripts/pilot.ts",
    "agent:mcp": "tsx scripts/agent-mcp.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "worker": "tsx --env-file-if-exists=.env src/worker/main.ts",
    "publisher": "tsx --env-file-if-exists=.env scripts/publisher.ts",
    "dev:all": "concurrently -k -n web,worker,publisher \"pnpm dev\" \"pnpm worker\" \"pnpm publisher\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:ui",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "types:api": "uv run python scripts/export_openapi.py && openapi-typescript packages/shared-types/openapi.json -o packages/shared-types/src/api.d.ts",
    "test:ui": "vitest run",
    "format:check": "prettier --check .",
    "mascot:cutout": "node -e \"require('child_process').spawnSync(process.platform==='win32'?'.tools/voice-venv/Scripts/python.exe':'.tools/voice-venv/bin/python',['scripts/voice/cutout.py',...process.argv.slice(1)],{stdio:'inherit'})\"",
    "ideas:index": "tsx --env-file-if-exists=.env scripts/ideas-index.ts",
    "owner:credits": "tsx --env-file-if-exists=.env scripts/owner-credits.ts"
  },
  "dependencies": {
    "@clipvero/shared-types": "workspace:*",
    "@clipvero/video-engine": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@remotion/bundler": "^4.0.535",
    "@remotion/player": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.65.0",
    "remotion": "^4.0.535",
    "sonner": "^2.0.7",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static",
      "esbuild",
      "sharp"
    ]
  }
}
