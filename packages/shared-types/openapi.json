          "name": {
            "type": "string",
            "title": "Name"
          },
          "workspaceName": {
            "type": "string",
            "title": "Workspacename"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "editor",
              "viewer"
            ],
            "title": "Role"
          },
          "credits": {
            "type": "integer",
            "title": "Credits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userId",
          "workspaceId",
          "email",
          "name",
          "workspaceName",
          "role",
          "credits"
        ],
        "title": "Identity"
      },
      "Message": {
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true,
            "title": "Ok",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Message"
      },
